<Window x:Class="SnapGlyph.App.HotkeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnapGlyph 设置"
        Width="600"
        Height="820"
        MinHeight="640"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#16181D"
        Foreground="#E8EAED"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2B333E" />
            <Setter Property="Foreground" Value="#F3F5F7" />
            <Setter Property="BorderBrush" Value="#53606E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#3A4655" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1C232C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#111318" />
            <Setter Property="Foreground" Value="#E8EAED" />
            <Setter Property="CaretBrush" Value="#E8EAED" />
            <Setter Property="BorderBrush" Value="#46515E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,5" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8EF0C2" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Width="520" Margin="20,20,20,12">
            <TextBlock Text="设置"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#F3F5F7" />
            <TextBlock Text="配置快捷键、识别模型、通知时长和选区外观。"
                       Foreground="#AAB1BC"
                       TextWrapping="Wrap"
                       Margin="0,5,0,14" />

            <Border Background="#1C2027"
                    BorderBrush="#343A44"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14"
                    Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="快捷键" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="点击“录制”，然后按新的组合键。快捷键必须包含 Ctrl、Alt、Shift 或 Win。"
                               Foreground="#AAB1BC"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="截图 / 控件选区" VerticalAlignment="Center" />
                        <TextBox x:Name="ScreenshotBox"
                                 Grid.Column="1"
                                 IsReadOnly="True"
                                 Margin="0,0,8,0"
                                 Foreground="#8EF0C2" />
                        <Button Grid.Column="2"
                                Content="录制"
                                Tag="Screenshot"
                                Padding="8,5"
                                Click="Record_Click" />
                    </Grid>

                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="OCR" VerticalAlignment="Center" />
                        <TextBox x:Name="OcrBox"
                                 Grid.Column="1"
                                 IsReadOnly="True"
                                 Margin="0,0,8,0"
                                 Foreground="#8EF0C2" />
                        <Button Grid.Column="2"
                                Content="录制"
                                Tag="Ocr"
                                Padding="8,5"
                                Click="Record_Click" />
                    </Grid>

                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="旋转 / 透视" VerticalAlignment="Center" />
                        <TextBox x:Name="TransformBox"
                                 Grid.Column="1"
                                 IsReadOnly="True"
                                 Margin="0,0,8,0"
                                 Foreground="#8EF0C2" />
                        <Button Grid.Column="2"
                                Content="录制"
                                Tag="Transform"
                                Padding="8,5"
                                Click="Record_Click" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="扫描条码 / 二维码"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="QrBox"
                                 Grid.Column="1"
                                 IsReadOnly="True"
                                 Margin="0,0,8,0"
                                 Foreground="#8EF0C2" />
                        <Button Grid.Column="2"
                                Content="录制"
                                Tag="Qr"
                                Padding="8,5"
                                Click="Record_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="#1C2027"
                    BorderBrush="#343A44"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14"
                    Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="识别与窗口" Style="{StaticResource SectionTitle}" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="OCR 模型" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <RadioButton x:Name="ModelHighAccuracyRadio"
                                         Content="高精度（Medium）"
                                         Foreground="#E8EAED"
                                         GroupName="ModelQuality" />
                            <RadioButton x:Name="ModelStandardRadio"
                                         Content="标准（Small，推荐）"
                                         Foreground="#E8EAED"
                                         GroupName="ModelQuality"
                                         IsChecked="True"
                                         Margin="18,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="OCR 超时"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="OcrTimeoutBox"
                                     Width="86" />
                            <TextBlock Text="毫秒（100–30000）"
                                       Foreground="#AAB1BC"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="ShowAfterScreenshotBox"
                              Content="截图后弹出主窗口（关闭时只复制图片到剪贴板）"
                              Foreground="#E8EAED"
                              Margin="0,2,0,6" />
                    <CheckBox x:Name="ShowAfterOcrBox"
                              Content="OCR 后弹出主窗口（关闭时只复制文字到剪贴板）"
                              Foreground="#E8EAED"
                              Margin="0,0,0,6" />
                    <CheckBox x:Name="ShowAfterQrBox"
                              Content="扫码后弹出主窗口（关闭时只复制内容到剪贴板）"
                              Foreground="#E8EAED" />
                    <CheckBox x:Name="ShowSuppressedRowsBox"
                              Content="显示“已抑制的重复框”诊断区（默认隐藏）"
                              Foreground="#E8EAED"
                              Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Background="#1C2027"
                    BorderBrush="#343A44"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14"
                    Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="个性化" Style="{StaticResource SectionTitle}" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="通知显示时长"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="NotificationDurationBox"
                                     Width="86" />
                            <TextBlock Text="秒（0.5–15）"
                                       Foreground="#AAB1BC"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="选区颜色"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="SelectionColorBox"
                                     Width="112"
                                     MaxLength="7"
                                     TextChanged="SelectionColorBox_TextChanged" />
                            <Border x:Name="SelectionColorPreview"
                                    Width="58"
                                    Height="30"
                                    Margin="8,0,0,0"
                                    CornerRadius="4"
                                    BorderBrush="#6B7785"
                                    BorderThickness="1" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="输入 #RRGGBB，例如 #00E5FF。此颜色用于截图、OCR、扫码和透视画布的选区边框。"
                               Foreground="#9099A6"
                               TextWrapping="Wrap"
                               Margin="150,6,0,0" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="十字线颜色"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="CrosshairColorBox"
                                     Width="112"
                                     MaxLength="7"
                                     TextChanged="CrosshairColorBox_TextChanged" />
                            <Border x:Name="CrosshairColorPreview"
                                    Width="58"
                                    Height="30"
                                    Margin="8,0,0,0"
                                    CornerRadius="4"
                                    BorderBrush="#6B7785"
                                    BorderThickness="1" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="输入 #RRGGBB，例如 #FFC107。此颜色用于截图、OCR 和扫码的十字辅助线。"
                               Foreground="#9099A6"
                               TextWrapping="Wrap"
                               Margin="150,6,0,0" />
                </StackPanel>
            </Border>

            <Border Background="#1C2027"
                    BorderBrush="#343A44"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14"
                    Margin="0,0,0,10">
                <CheckBox x:Name="StartWithWindowsBox"
                          Content="开机自动启动并驻留系统托盘"
                          Foreground="#E8EAED" />
            </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Background="#1C2027"
                BorderBrush="#343A44"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <StackPanel>
                <TextBlock x:Name="StatusText"
                           Foreground="#FFD180"
                           TextWrapping="Wrap"
                           MinHeight="20"
                           Margin="0,0,0,8" />
                <Grid>
                    <TextBlock Text="Esc 取消 / 关闭"
                               Foreground="#9099A6"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="恢复默认"
                                MinWidth="82"
                                Padding="12,7"
                                Margin="0,0,8,0"
                                Click="Defaults_Click" />
                        <Button Content="保存"
                                MinWidth="82"
                                Padding="18,7"
                                Margin="0,0,8,0"
                                Click="Save_Click" />
                        <Button Content="取消"
                                MinWidth="82"
                                Padding="18,7"
                                Click="Cancel_Click" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
